# Local development needs none of this — with DATABASE_URL unset the app uses PGlite,
# an embedded Postgres stored in .data/pglite, and migrates itself on first run.
#
# Set these only when pointing at a real Postgres server.

# DATABASE_URL="postgresql://user:password@host:5432/unnati"

# Render's managed Postgres presents its own CA; set this to trust the chain.
# Use "disable" for a local server with no TLS at all.
# DATABASE_SSL="require"

# Signs session cookies. Required in production; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET=""

# Live mandi prices from the Government of India Agmarknet feed (data.gov.in).
# Register a free key at https://data.gov.in — it takes about a minute. Without one
# the app still works, serving its shipped baseline prices and labelling them as such.
# DATA_GOV_API_KEY=""
